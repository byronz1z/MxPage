generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  ANALYZED
  PLANNED
  EDITING
  COMPLETED
}

enum AssetType {
  MAIN
  ANGLE
  DETAIL
  REFERENCE
  GENERATED
  EXPORTED
}

enum SectionType {
  HERO
  SELLING_POINTS
  SCENARIO
  DETAIL_CLOSEUP
  SPECS
  MATERIAL
  COMPARISON
  GIFT_SCENE
  BRAND_TRUST
  SUMMARY
  CUSTOM
}

enum GenerationStatus {
  IDLE
  QUEUED
  GENERATING
  SUCCESS
  FAILED
}

enum TaskType {
  ANALYZE
  PLAN
  GENERATE
  REGENERATE
  EXPORT
  BATCH_CREATE
  TRANSLATE_PAGE
  XHS_GENERATE
  QA_CHECK
}

enum TaskStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

model Project {
  id            String           @id @default(cuid())
  name          String
  status        ProjectStatus    @default(DRAFT)
  platform      String
  style         String
  description   String?
  modelSnapshot Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assets        ProductAsset[]
  analysis      ProductAnalysis?
  sections      PageSection[]
  tasks         GenerationTask[]
  detailRuns    DetailRun[]
}

model DetailRun {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idempotencyKey String
  status         String   @default("PENDING")
  stage          String   @default("准备中")
  input          Json
  checkpoint     Json
  leaseToken     String?
  leaseUntil     DateTime?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
}

model ProviderConfig {
  id              String         @id @default(cuid())
  name            String
  baseUrl         String
  textProtocol    String         @default("chat_completions")
  structuredOutputMode String    @default("json_schema")
  apiKeyEncrypted String
  isActive        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  models          ModelProfile[]
}

model ModelProfile {
  id                   String         @id @default(cuid())
  providerConfigId     String
  providerConfig       ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  modelId              String
  label                String
  capabilities         Json
  roles                Json
  quality              String?
  latency              String?
  cost                 String?
  isAvailable          Boolean        @default(true)
  isDefaultAnalysis    Boolean        @default(false)
  isDefaultPlanning    Boolean        @default(false)
  isDefaultHeroImage   Boolean        @default(false)
  isDefaultDetailImage Boolean        @default(false)
  isDefaultImageEdit   Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([providerConfigId, modelId])
  @@index([providerConfigId])
}

model ProductAsset {
  id                String         @id @default(cuid())
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId         String?
  section           PageSection?   @relation("SectionGeneratedAssets", fields: [sectionId], references: [id], onDelete: SetNull)
  type              AssetType
  filePath          String
  fileName          String
  mimeType          String?
  sortOrder         Int            @default(0)
  metadata          Json?
  isMain            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  currentForSection PageSection[]  @relation("CurrentSectionImage")
  versions          SectionVersion[]

  @@index([projectId, sortOrder])
  @@index([sectionId])
}

model ProductAnalysis {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rawResult        Json
  normalizedResult Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PageSection {
  id                  String           @id @default(cuid())
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionKey          String
  type                SectionType
  title               String
  goal                String
  copy                String
  visualPrompt        String
  order               Int
  status              GenerationStatus @default(IDLE)
  currentImageAssetId String?
  currentImageAsset   ProductAsset?    @relation("CurrentSectionImage", fields: [currentImageAssetId], references: [id], onDelete: SetNull)
  editableData        Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  versions            SectionVersion[]
  generatedAssets     ProductAsset[]   @relation("SectionGeneratedAssets")
  tasks               GenerationTask[]

  @@unique([projectId, sectionKey])
  @@index([projectId, order])
}

model SectionVersion {
  id             String       @id @default(cuid())
  sectionId      String
  section        PageSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  versionNumber  Int
  promptSnapshot Json
  copySnapshot   Json
  imageAssetId   String?
  imageAsset     ProductAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([sectionId, versionNumber])
  @@index([sectionId, createdAt])
}

model GenerationTask {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId    String?
  section      PageSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  taskType     TaskType
  status       TaskStatus  @default(PENDING)
  inputPayload Json?
  outputPayload Json?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([projectId, createdAt])
  @@index([sectionId, createdAt])
}

model AgentSession {
  id String @id @default(cuid())
  title String @default("新会话")
  modelId String?
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages AgentMessage[]
  runs AgentRun[]
  artifacts AgentArtifact[]
}
model AgentMessage {
  id String @id @default(cuid())
  sessionId String
  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role String
  content String
  attachments Json @default("[]")
  createdAt DateTime @default(now())
}
model AgentRun {
  id String @id @default(cuid())
  sessionId String
  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  idempotencyKey String
  status String @default("PENDING")
  mode String @default("chat")
  input Json
  snapshot Json
  plan Json?
  approvedHash String?
  modelCalls Int @default(0)
  toolCalls Int @default(0)
  modelLimit Int @default(30)
  toolLimit Int @default(100)
  leaseToken String?
  leaseUntil DateTime?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events AgentEvent[]
  calls AgentToolCall[]
  artifacts AgentArtifact[]
  checkpoints AgentCheckpoint[]
  writes AgentCheckpointWrite[]
  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, createdAt])
}
model AgentEvent {
  seq Int @id @default(autoincrement())
  runId String
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  type String
  data Json
  createdAt DateTime @default(now())
  @@index([runId, seq])
}
model AgentToolCall {
  id String @id @default(cuid())
  runId String
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  callId String
  name String
  argsHash String
  status String @default("RUNNING")
  output Json?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([runId, callId])
}
model AgentArtifact {
  id String @id @default(cuid())
  sessionId String
  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  runId String?
  run AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  name String
  mimeType String
  filePath String?
  url String?
  kind String
  bytes Int @default(0)
  createdAt DateTime @default(now())
}
model AgentCheckpoint {
  runId String
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  namespace String
  checkpointId String
  parentId String?
  type String
  checkpoint Bytes
  metadata Bytes
  @@id([runId, namespace, checkpointId])
}
model AgentCheckpointWrite {
  runId String
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  namespace String
  checkpointId String
  taskId String
  idx Int
  channel String
  type String
  value Bytes
  @@id([runId, namespace, checkpointId, taskId, idx])
}
model AgentSetting {
  id String @id @default("default")
  value Json
}
