DATABASE_URL="file:./dev.db"
APP_SECRET="replace-with-your-own-long-secret"
STORAGE_ROOT="./storage"
APP_RUNTIME="web"
# APP_USER_DATA_DIR=""
NEXT_PUBLIC_APP_NAME="MxPage"
# Optional public deployment URL for homepage canonical, Open Graph and sitemap.
# Leave unset for local/desktop usage; workspace pages always request no indexing.
# NEXT_PUBLIC_SITE_URL="https://your-mxpage.example.com"

# Optional private-deployment guardrail:
# when set, all server-side provider requests ignore the UI baseURL and use this endpoint.
# LOCK_BASE_URL="https://your-private-openai-compatible-gateway/v1"
# Legacy aliases are also supported: FORCED_API_BASE / FORCED_API_BASE_URL
